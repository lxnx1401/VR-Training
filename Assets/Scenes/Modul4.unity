--- !u!114 &171242939
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 171242931}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d36efbd9970bacd0385aa809c60755c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogueLines:
  - audioClip: {fileID: 8300000, guid: 4b3cb324d3295734bb9761b94070cb15, type: 3}
    subtitle: Welcome to Module 4. Now you get to control the robot.
    talkTrigger: wave
    waitForTaskUnlock: 0
  - audioClip: {fileID: 8300000, guid: 6f16e9b1375b10749bb0aea09eb8aafd, type: 3}
    subtitle: 'There are two control modes: Control Mode for movement, and Animation
      Mode for actions like waving or dancing.'
    talkTrigger: expl
    waitForTaskUnlock: 0
  - audioClip: {fileID: 8300000, guid: 8dc299cba6ec64e4c96bec001a2b7070, type: 3}
    subtitle: "Your priority is safety: keep your distance and step back if the robot
      comes too close \u2014 never block the moving robot."
    talkTrigger: talk2
    waitForTaskUnlock: 0
  - audioClip: {fileID: 8300000, guid: d7e5830da7703d044a8221d58c8fae9e, type: 3}
    subtitle: Press X to open the controller again.
    talkTrigger: argu
    waitForTaskUnlock: 1
  - audioClip: {fileID: 8300000, guid: 74300962135523144aacaba2e9b5ed5b, type: 3}
    subtitle: "Switch to Control Mode and press \u2018Forward\u2019 to begin the
      task."
    talkTrigger: talk
    waitForTaskUnlock: 1
  - audioClip: {fileID: 8300000, guid: 5cc9a74cd5dc6c54bb611df235cf362c, type: 3}
    subtitle: "Now keep the robot moving safely for 20 seconds. If the robot enters
      the unsafe zone, the timer resets \u2014 step back and regain a safe distance."
    talkTrigger: talk2
    waitForTaskUnlock: 1
  - audioClip: {fileID: 8300000, guid: 6a61ffe7d74db3c47a4c40d6e66548e4, type: 3}
    subtitle: Good control, you're completed the task. Switch now to Animation Mode.
    talkTrigger: expl
    waitForTaskUnlock: 1
  - audioClip: {fileID: 8300000, guid: ca5d39cc62264d34392a16522ff219db, type: 3}
    subtitle: "Press \u2018Wave\u2019, \u2018Dance\u2019 and \u2018Kick\u2019. Keep
      your distance and stay focused on the robot."
    talkTrigger: argu
    waitForTaskUnlock: 1
  - audioClip: {fileID: 8300000, guid: 6177878a3156ea64391e0fe2f9dc641d, type: 3}
    subtitle: "Perfect. Safe movement and clean commands \u2014 module completed."
    talkTrigger: happy
    waitForTaskUnlock: 0
  isWaitingForTask: 0
  subtitleText: {fileID: 582177647}
  speakerNameText: {fileID: 0}
  subtitleGroup: {fileID: 546229627}
